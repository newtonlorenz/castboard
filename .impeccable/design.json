      "css": ".ds-field{font:14px/1.45 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:flex;flex-direction:column;gap:6px;margin-bottom:14px;min-width:0}.ds-field>span{font-size:12px;font-weight:600;color:#465266}.ds-field input{font:inherit;width:100%;min-height:40px;padding:9px 10px;background:var(--paper,#fff);color:var(--ink,#202b3c);border:1px solid #bcc7d5;border-radius:5px}.ds-field input:hover{border-color:#71829a}.ds-field input:focus,.ds-field input:focus-visible{outline:2px solid var(--accent,#2459bb);outline-offset:1px}.ds-field input:invalid{border-color:var(--error,#a82727)} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
