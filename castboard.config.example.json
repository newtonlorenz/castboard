{
  "server": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "branding": {
    "name": "Castboard",
    "subtitle": "Home at a glance",
    "location": "Your home",
    "accent": "#8ee6c2",
    "timeZone": "Europe/Madrid"
  },
  "defaultScreen": "home",
  "screens": {
    "home": {
      "path": "/",
      "title": "Home",
      "targets": ["Kitchen Display"],
      "grid": { "columns": 12, "rows": 8, "gap": 8, "padding": 8 },
      "panels": [
        { "id": "focus", "plugin": "focus", "position": { "column": 1, "row": 1, "width": 8, "height": 1 } },
        { "id": "solar", "plugin": "solar", "position": { "column": 9, "row": 1, "width": 4, "height": 1 } },
        { "id": "clock", "plugin": "clock", "position": { "column": 1, "row": 2, "width": 3, "height": 2 } },
        { "id": "weather", "plugin": "weather", "position": { "column": 4, "row": 2, "width": 2, "height": 2 } },
        { "id": "recovery", "plugin": "recovery", "position": { "column": 6, "row": 2, "width": 2, "height": 2 } },
        { "id": "spotify", "plugin": "spotify", "position": { "column": 8, "row": 2, "width": 5, "height": 2 } },
        { "id": "stocks", "plugin": "stocks", "position": { "column": 1, "row": 4, "width": 6, "height": 4 } },
        { "id": "calendar", "plugin": "calendar", "position": { "column": 7, "row": 4, "width": 3, "height": 4 } },
        { "id": "camera", "plugin": "camera", "position": { "column": 10, "row": 4, "width": 3, "height": 4 } },
        { "id": "news-strip", "plugin": "news", "position": { "column": 1, "row": 8, "width": 12, "height": 1 }, "options": { "view": "compact", "title": "Headlines" } }
      ]
    },
    "office": {
      "path": "/screens/office",
      "title": "Office",
      "targets": ["Office Display"],
      "grid": { "columns": 12, "rows": 8, "gap": 8, "padding": 8 },
      "panels": [
        { "id": "market-news", "plugin": "news", "position": { "column": 1, "row": 1, "width": 12, "height": 8 }, "options": { "view": "wire", "title": "Bloomberg", "rotationSeconds": 18 } }
      ]
    }
  },
  "plugins": {
    "clock": { "enabled": true, "showSeconds": false },
    "focus": { "enabled": true },
    "weather": {
      "enabled": true,
      "provider": "demo",
      "label": "Your town"
    },
    "solar": { "enabled": true, "provider": "demo" },
    "recovery": { "enabled": true, "provider": "demo" },
    "spotify": { "enabled": true, "provider": "demo" },
    "stocks": { "enabled": true, "provider": "demo", "currency": "EUR" },
    "calendar": { "enabled": true, "provider": "demo" },
    "camera": { "enabled": true, "provider": "demo", "name": "Front garden" },
    "news": { "enabled": true, "provider": "demo" }
  }
}
