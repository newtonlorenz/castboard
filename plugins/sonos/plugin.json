{
  "name": "Sonos",
  "description": "Playback and controls through a Sonos HTTP bridge.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "sonos-http",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "sonos-http": "Sonos bridge",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache · milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "sonos-http",
            "http-json"
          ]
        },
        "advanced": true
      },
      "baseUrl": {
        "type": "string",
        "title": "Sonos bridge URL",
        "showWhen": {
          "provider": [
            "sonos-http"
          ]
        }
      },
      "statusPath": {
        "type": "string",
        "title": "Status path",
        "advanced": true,
        "showWhen": {
          "provider": [
            "sonos-http"
          ]
        }
      },
      "actionMethod": {
        "type": "string",
        "title": "Control request method",
        "enum": [
          "POST",
          "GET"
        ],
        "advanced": true,
        "showWhen": {
          "provider": [
            "sonos-http"
          ]
        }
      },
      "actions": {
        "type": "object",
        "title": "Control paths",
        "advanced": true,
        "showWhen": {
          "provider": [
            "sonos-http"
          ]
        }
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  }
}
