{
  "name": "Current Weather Panel",
  "description": "Show current conditions supplied by a weather adapter. Choose Celsius or Fahrenheit and update timing.",
  "version": "1.1.0",
  "license": "MIT",
  "category": "Dashboard panels",
  "defaultConfig": {},
  "settingsSchema": {
    "type": "object",
    "properties": {
      "displayName": {
        "type": "string",
        "title": "Name in admin",
        "maxLength": 100,
        "group": "General",
        "description": "Name this copy for its purpose, such as Lobby weather or Workshop energy. Its connection ID stays the same."
      },
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600,
        "description": "How often the display checks for new data. Server caching may reuse the previous response.",
        "group": "Updates"
      },
      "temperatureUnit": {
        "type": "string",
        "title": "Temperature unit",
        "enum": [
          "celsius",
          "fahrenheit"
        ],
        "default": "celsius",
        "group": "Display"
      },
      "windUnit": {
        "type": "string",
        "title": "Wind unit",
        "enum": [
          "kph",
          "mph",
          "ms"
        ],
        "default": "kph",
        "group": "Display"
      },
      "showFeels": {
        "type": "boolean",
        "title": "Show feels-like temperature",
        "default": true,
        "group": "Display"
      },
      "showHumidity": {
        "type": "boolean",
        "title": "Show humidity",
        "default": true,
        "group": "Display"
      },
      "showWind": {
        "type": "boolean",
        "title": "Show wind",
        "default": true,
        "group": "Display"
      },
      "showUv": {
        "type": "boolean",
        "title": "Show UV index",
        "default": true,
        "group": "Display"
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600,
        "description": "How often the display checks for new data. Server caching may reuse the previous response.",
        "group": "Updates"
      },
      "temperatureUnit": {
        "type": "string",
        "title": "Temperature unit",
        "enum": [
          "celsius",
          "fahrenheit"
        ],
        "default": "celsius",
        "group": "Display"
      },
      "windUnit": {
        "type": "string",
        "title": "Wind unit",
        "enum": [
          "kph",
          "mph",
          "ms"
        ],
        "default": "kph",
        "group": "Display"
      },
      "showFeels": {
        "type": "boolean",
        "title": "Show feels-like temperature",
        "default": true,
        "group": "Display"
      },
      "showHumidity": {
        "type": "boolean",
        "title": "Show humidity",
        "default": true,
        "group": "Display"
      },
      "showWind": {
        "type": "boolean",
        "title": "Show wind",
        "default": true,
        "group": "Display"
      },
      "showUv": {
        "type": "boolean",
        "title": "Show UV index",
        "default": true,
        "group": "Display"
      }
    }
  },
  "defaultBindings": {
    "runtime": "ambient-runtime",
    "theme": "ambient-theme",
    "weather": "ambient-weather-source"
  },
  "dependencies": [
    "ambient-runtime",
    "ambient-theme",
    "ambient-weather-source"
  ],
  "internalBindings": [
    "runtime",
    "theme"
  ],
  "connectionSchema": {
    "weather": {
      "title": "Weather",
      "contract": "weather-source@1",
      "capabilities": [
        "data"
      ],
      "required": true,
      "description": "Select a configured source. Its account and update settings stay with that source."
    }
  }
}
