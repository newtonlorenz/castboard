{
  "name": "Ambient Weather",
  "description": "Temperature, conditions, humidity, wind and UV.",
  "version": "1.0.0",
  "license": "MIT",
  "category": "Ambient displays",
  "defaultConfig": {},
  "settingsSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600
      },
      "temperatureUnit": {
        "type": "string",
        "title": "Temperature unit",
        "enum": [
          "celsius",
          "fahrenheit"
        ],
        "default": "celsius"
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600
      },
      "temperatureUnit": {
        "type": "string",
        "title": "Temperature unit",
        "enum": [
          "celsius",
          "fahrenheit"
        ],
        "default": "celsius"
      }
    }
  },
  "defaultBindings": {
    "runtime": "ambient-runtime",
    "theme": "ambient-theme",
    "config": "ambient-config-source",
    "services": "ambient-services",
    "weather": "ambient-weather-source"
  },
  "dependencies": [
    "ambient-runtime",
    "ambient-theme",
    "ambient-config-source",
    "ambient-services",
    "ambient-weather-source"
  ]
}
