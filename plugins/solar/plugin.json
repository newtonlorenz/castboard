{
  "name": "Solar",
  "description": "Energy production and usage from Fronius or JSON.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "fronius",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "fronius": "Fronius inverter",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache · milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "baseUrl": {
        "type": "string",
        "title": "Inverter URL",
        "showWhen": {
          "provider": [
            "fronius"
          ]
        }
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      }
    }
  }
}
