{
  "name": "Weather",
  "description": "Current conditions, UV, hourly and seven-day forecasts from Open-Meteo or your own data.",
  "version": "1.3.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo",
    "cacheMs": 300000
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "open-meteo",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "open-meteo": "Open-Meteo (no account needed)",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache \u00b7 milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout \u00b7 milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "latitude": {
        "type": "number",
        "title": "Latitude",
        "minimum": -90,
        "maximum": 90,
        "showWhen": {
          "provider": [
            "open-meteo"
          ]
        }
      },
      "longitude": {
        "type": "number",
        "title": "Longitude",
        "minimum": -180,
        "maximum": 180,
        "showWhen": {
          "provider": [
            "open-meteo"
          ]
        }
      },
      "label": {
        "type": "string",
        "title": "Location label"
      },
      "view": {
        "type": "string",
        "title": "Show",
        "enum": [
          "current",
          "hourly",
          "daily",
          "forecast"
        ],
        "enumLabels": {
          "current": "Current weather",
          "hourly": "Hourly forecast",
          "daily": "Daily forecast",
          "forecast": "Current and forecast"
        }
      },
      "hours": {
        "type": "integer",
        "title": "Forecast hours",
        "minimum": 1,
        "maximum": 24
      },
      "days": {
        "type": "integer",
        "title": "Forecast days",
        "minimum": 1,
        "maximum": 7
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 30,
        "maximum": 3600
      },
      "forecastLayout": {
        "type": "string",
        "title": "Forecast layout",
        "enum": [
          "auto",
          "paged",
          "full"
        ],
        "enumLabels": {
          "auto": "Fit the panel",
          "paged": "Pages with Previous / Next",
          "full": "Full forecast (scrollable)"
        }
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "title": "Location label"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "view": {
        "type": "string",
        "title": "Show",
        "enum": [
          "current",
          "hourly",
          "daily",
          "forecast"
        ],
        "enumLabels": {
          "current": "Current weather",
          "hourly": "Hourly forecast",
          "daily": "Daily forecast",
          "forecast": "Current and forecast"
        }
      },
      "hours": {
        "type": "integer",
        "title": "Forecast hours",
        "minimum": 1,
        "maximum": 24
      },
      "days": {
        "type": "integer",
        "title": "Forecast days",
        "minimum": 1,
        "maximum": 7
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 30,
        "maximum": 3600
      },
      "forecastLayout": {
        "type": "string",
        "title": "Forecast layout",
        "enum": [
          "auto",
          "paged",
          "full"
        ],
        "enumLabels": {
          "auto": "Fit the panel",
          "paged": "Pages with Previous / Next",
          "full": "Full forecast (scrollable)"
        }
      }
    }
  }
}
