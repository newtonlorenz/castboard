{
  "name": "Clock Panel",
  "description": "Show time and date using shared display settings, with optional time zone and location overrides.",
  "version": "1.1.0",
  "license": "MIT",
  "category": "Dashboard panels",
  "defaultConfig": {},
  "settingsSchema": {
    "type": "object",
    "properties": {
      "displayName": {
        "type": "string",
        "title": "Name in admin",
        "maxLength": 100,
        "group": "General",
        "description": "Name this copy for its purpose, such as Lobby weather or Workshop energy. Its connection ID stays the same."
      },
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "showSeconds": {
        "type": "boolean",
        "title": "Show seconds",
        "default": true,
        "group": "Display"
      },
      "hour12": {
        "type": "boolean",
        "title": "12-hour clock",
        "default": false,
        "group": "Display"
      },
      "timeZone": {
        "type": "string",
        "title": "Time zone",
        "description": "IANA time zone, for example Europe/Madrid or America/New_York. Empty uses the shared display time zone.",
        "group": "Display"
      },
      "location": {
        "type": "string",
        "title": "Location label",
        "group": "Display"
      },
      "showDate": {
        "type": "boolean",
        "title": "Show date",
        "default": true,
        "group": "Display"
      },
      "locale": {
        "type": "string",
        "title": "Language and region",
        "description": "Leave empty for the browser\u2019s language, or use a locale such as en-GB or fr-FR.",
        "group": "Display"
      },
      "dateStyle": {
        "type": "string",
        "title": "Date style",
        "enum": [
          "long",
          "short",
          "numeric"
        ],
        "default": "long",
        "group": "Display"
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "showSeconds": {
        "type": "boolean",
        "title": "Show seconds",
        "default": true,
        "group": "Display"
      },
      "hour12": {
        "type": "boolean",
        "title": "12-hour clock",
        "default": false,
        "group": "Display"
      },
      "timeZone": {
        "type": "string",
        "title": "Time zone",
        "description": "IANA time zone, for example Europe/Madrid or America/New_York. Empty uses the shared display time zone.",
        "group": "Display"
      },
      "location": {
        "type": "string",
        "title": "Location label",
        "group": "Display"
      },
      "showDate": {
        "type": "boolean",
        "title": "Show date",
        "default": true,
        "group": "Display"
      },
      "locale": {
        "type": "string",
        "title": "Language and region",
        "description": "Leave empty for the browser\u2019s language, or use a locale such as en-GB or fr-FR.",
        "group": "Display"
      },
      "dateStyle": {
        "type": "string",
        "title": "Date style",
        "enum": [
          "long",
          "short",
          "numeric"
        ],
        "default": "long",
        "group": "Display"
      }
    }
  },
  "defaultBindings": {
    "runtime": "ambient-runtime",
    "theme": "ambient-theme",
    "config": "ambient-config-source",
    "services": "ambient-services"
  },
  "dependencies": [
    "ambient-runtime",
    "ambient-theme",
    "ambient-config-source",
    "ambient-services"
  ]
}
