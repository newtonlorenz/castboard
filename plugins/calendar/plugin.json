{
  "name": "Calendar",
  "description": "Events from an ICS feed or your own JSON source.",
  "version": "1.3.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "ics",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "ics": "Calendar feed (ICS)",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache \u00b7 milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout \u00b7 milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "Calendar feed URL",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "ics",
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "maxEvents": {
        "type": "integer",
        "title": "Default number of events",
        "minimum": 1,
        "maximum": 100
      },
      "compact": {
        "type": "boolean",
        "title": "Compact layout",
        "default": false
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "maxEvents": {
        "type": "integer",
        "title": "Events to show",
        "minimum": 1,
        "maximum": 100
      },
      "compact": {
        "type": "boolean",
        "title": "Compact layout",
        "default": false
      }
    }
  }
}
