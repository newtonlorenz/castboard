{
  "name": "Ambient Recovery",
  "description": "Recovery percentage with optional sleep and strain.",
  "version": "1.0.0",
  "license": "MIT",
  "category": "Ambient displays",
  "defaultConfig": {},
  "settingsSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600
      },
      "showSleep": {
        "type": "boolean",
        "title": "Show sleep",
        "default": true
      },
      "showStrain": {
        "type": "boolean",
        "title": "Show strain",
        "default": true
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 3600
      },
      "showSleep": {
        "type": "boolean",
        "title": "Show sleep",
        "default": true
      },
      "showStrain": {
        "type": "boolean",
        "title": "Show strain",
        "default": true
      }
    }
  },
  "defaultBindings": {
    "runtime": "ambient-runtime",
    "theme": "ambient-theme",
    "config": "ambient-config-source",
    "services": "ambient-services",
    "recovery": "ambient-recovery-source"
  },
  "dependencies": [
    "ambient-runtime",
    "ambient-theme",
    "ambient-config-source",
    "ambient-services",
    "ambient-recovery-source"
  ]
}
