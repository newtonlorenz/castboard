{
  "name": "News and briefings",
  "description": "RSS, Atom, Markdown and JSON stories with an interactive reader.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "rss",
          "markdown-directory",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "rss": "RSS / Atom feeds",
          "markdown-directory": "Markdown folder",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache · milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "Markdown directory or JSON file",
        "showWhen": {
          "provider": [
            "file-json",
            "markdown-directory"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "feeds": {
        "type": "array",
        "title": "RSS / Atom feeds",
        "description": "A list of objects with name and url.",
        "showWhen": {
          "provider": [
            "rss"
          ]
        }
      },
      "maxFiles": {
        "type": "integer",
        "title": "Markdown files to read",
        "minimum": 1,
        "maximum": 100,
        "showWhen": {
          "provider": [
            "markdown-directory"
          ]
        }
      },
      "maxStories": {
        "type": "integer",
        "title": "Maximum stories",
        "minimum": 1,
        "maximum": 200
      },
      "refreshMinutes": {
        "type": "integer",
        "title": "Feed refresh · minutes",
        "minimum": 1,
        "maximum": 1440,
        "showWhen": {
          "provider": [
            "rss"
          ]
        }
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "view": {
        "type": "string",
        "title": "Presentation",
        "enum": [
          "compact",
          "list",
          "wire"
        ]
      },
      "maxStories": {
        "type": "integer",
        "title": "Stories to show",
        "minimum": 1,
        "maximum": 200
      },
      "rotationSeconds": {
        "type": "integer",
        "title": "Seconds per story",
        "minimum": 1,
        "maximum": 300
      }
    }
  }
}
