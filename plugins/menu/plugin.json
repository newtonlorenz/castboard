{
  "name": "Menu & Price List",
  "description": "Display a cafe menu, shop price list, services or available products. Enter items or connect a JSON inventory.",
  "version": "1.0.0",
  "license": "MIT",
  "category": "Display plugins",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "displayName": {
        "type": "string",
        "title": "Name in admin",
        "maxLength": 100,
        "group": "General"
      },
      "provider": {
        "type": "string",
        "title": "Content source",
        "enum": [
          "demo",
          "inline",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "inline": "Enter here",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        },
        "default": "demo",
        "group": "Data source"
      },
      "url": {
        "type": "string",
        "title": "JSON source URL",
        "group": "Data source",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "group": "Data source",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Private request headers",
        "private": true,
        "advanced": true,
        "group": "Data source",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Source timeout · milliseconds",
        "minimum": 500,
        "maximum": 60000,
        "default": 8000,
        "advanced": true,
        "group": "Updates"
      },
      "items": {
        "type": "array",
        "title": "Menu & Price List items",
        "group": "Content",
        "maxItems": 100,
        "default": [],
        "showWhen": {
          "provider": [
            "inline"
          ]
        },
        "items": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Item name",
              "maxLength": 100
            },
            "section": {
              "type": "string",
              "title": "Section",
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "title": "Description",
              "maxLength": 240
            },
            "price": {
              "type": "number",
              "title": "Price",
              "minimum": 0
            },
            "available": {
              "type": "boolean",
              "title": "Available",
              "default": true
            },
            "note": {
              "type": "string",
              "title": "Note or dietary label",
              "maxLength": 100
            }
          }
        }
      },
      "title": {
        "type": "string",
        "title": "Display title",
        "maxLength": 120,
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Check source · seconds",
        "minimum": 15,
        "maximum": 3600,
        "default": 60,
        "group": "Updates"
      },
      "autoRotate": {
        "type": "boolean",
        "title": "Change pages automatically",
        "default": true,
        "group": "Display"
      },
      "rotationSeconds": {
        "type": "integer",
        "title": "Time per page · seconds",
        "minimum": 5,
        "maximum": 600,
        "default": 20,
        "group": "Display"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show page controls",
        "default": true,
        "group": "Display"
      },
      "pageSize": {
        "type": "integer",
        "title": "Items per page",
        "minimum": 0,
        "maximum": 30,
        "default": 0,
        "description": "0 fits the panel height. Automatic pages also work on screens without touch.",
        "group": "Display"
      },
      "currency": {
        "type": "string",
        "title": "Currency code",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR",
        "description": "Three-letter currency code, such as EUR, USD or GBP.",
        "group": "Display"
      },
      "hideUnavailable": {
        "type": "boolean",
        "title": "Hide unavailable items",
        "default": false,
        "group": "Content"
      },
      "missingPriceText": {
        "type": "string",
        "title": "Label when no price is supplied",
        "maxLength": 60,
        "default": "Ask for price",
        "group": "Display"
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Display title",
        "maxLength": 120,
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Check source · seconds",
        "minimum": 15,
        "maximum": 3600,
        "default": 60,
        "group": "Updates"
      },
      "autoRotate": {
        "type": "boolean",
        "title": "Change pages automatically",
        "default": true,
        "group": "Display"
      },
      "rotationSeconds": {
        "type": "integer",
        "title": "Time per page · seconds",
        "minimum": 5,
        "maximum": 600,
        "default": 20,
        "group": "Display"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show page controls",
        "default": true,
        "group": "Display"
      },
      "pageSize": {
        "type": "integer",
        "title": "Items per page",
        "minimum": 0,
        "maximum": 30,
        "default": 0,
        "description": "0 fits the panel height. Automatic pages also work on screens without touch.",
        "group": "Display"
      },
      "currency": {
        "type": "string",
        "title": "Currency code",
        "pattern": "^[A-Z]{3}$",
        "default": "EUR",
        "description": "Three-letter currency code, such as EUR, USD or GBP.",
        "group": "Display"
      },
      "hideUnavailable": {
        "type": "boolean",
        "title": "Hide unavailable items",
        "default": false,
        "group": "Content"
      },
      "missingPriceText": {
        "type": "string",
        "title": "Label when no price is supplied",
        "maxLength": 60,
        "default": "Ask for price",
        "group": "Display"
      }
    }
  },
  "displayNotes": "Prices use one configurable currency for the whole panel. Missing prices show the configured label; zero prices remain visible. Unavailable items can stay visible with a label or be hidden."
}
