{
  "name": "Spotify",
  "description": "Playback through spotify_player or read-only JSON.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "spotify-player",
          "http-json",
          "file-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "spotify-player": "Spotify player",
          "http-json": "Web endpoint (JSON)",
          "file-json": "Local file (JSON)"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache · milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "executable": {
        "type": "string",
        "title": "Spotify player executable",
        "advanced": true,
        "showWhen": {
          "provider": [
            "spotify-player"
          ]
        }
      },
      "configFolder": {
        "type": "string",
        "title": "Spotify configuration directory",
        "advanced": true,
        "showWhen": {
          "provider": [
            "spotify-player"
          ]
        }
      },
      "cacheFolder": {
        "type": "string",
        "title": "Spotify cache directory",
        "advanced": true,
        "showWhen": {
          "provider": [
            "spotify-player"
          ]
        }
      },
      "deviceName": {
        "type": "string",
        "title": "Default speaker name",
        "showWhen": {
          "provider": [
            "spotify-player"
          ]
        }
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  }
}
