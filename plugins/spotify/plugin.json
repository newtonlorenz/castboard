{
  "name": "Spotify",
  "description": "Playback through spotify_player or read-only JSON.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data provider",
        "enum": [
          "demo",
          "spotify-player",
          "http-json",
          "file-json"
        ]
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache \u00b7 milliseconds",
        "minimum": 0,
        "maximum": 3600000
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout \u00b7 milliseconds",
        "minimum": 500,
        "maximum": 120000
      },
      "url": {
        "type": "string",
        "title": "JSON endpoint",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "path": {
        "type": "string",
        "title": "JSON file path",
        "showWhen": {
          "provider": [
            "file-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "executable": {
        "type": "string",
        "title": "Spotify player executable"
      },
      "configFolder": {
        "type": "string",
        "title": "Spotify configuration directory"
      },
      "cacheFolder": {
        "type": "string",
        "title": "Spotify cache directory"
      },
      "deviceName": {
        "type": "string",
        "title": "Default speaker name"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "showControls": {
        "type": "boolean",
        "title": "Show playback controls",
        "default": true
      }
    }
  }
}
