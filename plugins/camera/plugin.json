{
  "name": "Camera Viewer",
  "description": "Show a live stream or refreshing snapshots from a camera service or Home Assistant. Control image fit, titles and update timestamps.",
  "version": "1.4.0",
  "license": "MIT",
  "category": "Display plugins",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "displayName": {
        "type": "string",
        "title": "Name in admin",
        "maxLength": 100,
        "group": "General",
        "description": "Name this copy for its purpose, such as Lobby weather or Workshop energy. Its connection ID stays the same."
      },
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "stream",
          "camera-service",
          "home-assistant"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "stream": "Direct camera stream",
          "camera-service": "Camera service",
          "home-assistant": "Home Assistant"
        },
        "description": "Choose where this copy gets its data. Sample data lets you try the display before connecting a service.",
        "group": "Data source"
      },
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache \u00b7 milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true,
        "description": "How long server responses are reused. 0 bypasses this response cache; a provider may also have its own refresh interval.",
        "group": "Updates"
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout \u00b7 milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true,
        "description": "Maximum wait for an upstream response before showing an unavailable state.",
        "group": "Updates"
      },
      "baseUrl": {
        "type": "string",
        "title": "Service URL",
        "showWhen": {
          "provider": [
            "camera-service",
            "home-assistant"
          ]
        },
        "description": "Base address of the compatible service, reachable from the Castboard server.",
        "group": "Data source"
      },
      "streamUrl": {
        "type": "string",
        "title": "Camera stream URL",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "stream"
          ]
        },
        "group": "Data source"
      },
      "name": {
        "type": "string",
        "title": "Camera label",
        "group": "Display"
      },
      "listPath": {
        "type": "string",
        "title": "Camera list path",
        "advanced": true,
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        },
        "group": "Data source"
      },
      "streamPath": {
        "type": "string",
        "title": "Stream path template",
        "advanced": true,
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        },
        "group": "Data source"
      },
      "preferredId": {
        "type": "string",
        "title": "Preferred camera ID",
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        },
        "group": "Data source"
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "advanced": true,
        "showWhen": {
          "provider": [
            "stream",
            "camera-service"
          ]
        },
        "description": "Optional request headers as a JSON object. Saved values are hidden and never sent to displays.",
        "group": "Data source"
      },
      "snapshotUrl": {
        "type": "string",
        "title": "Snapshot URL (optional)",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "stream"
          ]
        },
        "group": "Data source"
      },
      "token": {
        "type": "string",
        "title": "Home Assistant token",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "home-assistant"
          ]
        },
        "description": "Authentication token kept on the server. Leave empty when editing to keep the saved value.",
        "group": "Data source"
      },
      "entity": {
        "type": "string",
        "title": "Camera entity",
        "showWhen": {
          "provider": [
            "home-assistant"
          ]
        },
        "group": "Data source"
      },
      "displayMode": {
        "type": "string",
        "title": "Show",
        "enum": [
          "stream",
          "snapshot",
          "shortcut"
        ],
        "enumLabels": {
          "stream": "Live stream",
          "snapshot": "Snapshots",
          "shortcut": "Camera shortcut"
        },
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Snapshot refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 300,
        "description": "How often the display checks for new data. Server caching may reuse the previous response.",
        "group": "Updates"
      },
      "showRefresh": {
        "type": "boolean",
        "title": "Show Refresh image button",
        "group": "Display"
      },
      "fit": {
        "type": "string",
        "title": "Image fit",
        "enum": [
          "cover",
          "contain"
        ],
        "enumLabels": {
          "cover": "Fill panel",
          "contain": "Show whole image"
        },
        "group": "Display"
      },
      "showTitle": {
        "type": "boolean",
        "title": "Show camera title",
        "group": "Display"
      },
      "overlayTimestamp": {
        "type": "boolean",
        "title": "Show update time over image",
        "description": "Place the update time at the top of the image. Hide the Refresh image button to give the image more room.",
        "group": "Display"
      },
      "timeZone": {
        "type": "string",
        "title": "Update time zone",
        "description": "Empty uses the screen\u2019s time zone. For example Europe/Madrid or America/New_York.",
        "group": "Display"
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Display title",
        "description": "Default heading on the display. A screen panel can override it.",
        "group": "Display"
      },
      "name": {
        "type": "string",
        "title": "Camera label",
        "group": "Display"
      },
      "displayMode": {
        "type": "string",
        "title": "Show",
        "enum": [
          "stream",
          "snapshot",
          "shortcut"
        ],
        "enumLabels": {
          "stream": "Live stream",
          "snapshot": "Snapshots",
          "shortcut": "Camera shortcut"
        },
        "group": "Display"
      },
      "refreshSeconds": {
        "type": "integer",
        "title": "Snapshot refresh \u00b7 seconds",
        "minimum": 1,
        "maximum": 300,
        "description": "How often the display checks for new data. Server caching may reuse the previous response.",
        "group": "Updates"
      },
      "showRefresh": {
        "type": "boolean",
        "title": "Show Refresh image button",
        "group": "Display"
      },
      "fit": {
        "type": "string",
        "title": "Image fit",
        "enum": [
          "cover",
          "contain"
        ],
        "enumLabels": {
          "cover": "Fill panel",
          "contain": "Show whole image"
        },
        "group": "Display"
      },
      "showTitle": {
        "type": "boolean",
        "title": "Show camera title",
        "group": "Display"
      },
      "overlayTimestamp": {
        "type": "boolean",
        "title": "Show update time over image",
        "description": "Place the update time at the top of the image. Hide the Refresh image button to give the image more room.",
        "group": "Display"
      },
      "timeZone": {
        "type": "string",
        "title": "Update time zone",
        "description": "Empty uses the screen\u2019s time zone. For example Europe/Madrid or America/New_York.",
        "group": "Display"
      }
    }
  }
}
