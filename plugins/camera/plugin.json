{
  "name": "Camera",
  "description": "HTTP images and browser-compatible camera streams.",
  "version": "1.2.0",
  "license": "MIT",
  "category": "Display",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "stream",
          "camera-service"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "stream": "Direct camera stream",
          "camera-service": "Camera service"
        }
      },
      "title": {
        "type": "string",
        "title": "Default title"
      },
      "cacheMs": {
        "type": "integer",
        "title": "Response cache · milliseconds",
        "minimum": 0,
        "maximum": 3600000,
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Request timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      },
      "baseUrl": {
        "type": "string",
        "title": "Camera service URL",
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        }
      },
      "streamUrl": {
        "type": "string",
        "title": "Camera stream URL",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "stream"
          ]
        }
      },
      "name": {
        "type": "string",
        "title": "Camera label"
      },
      "listPath": {
        "type": "string",
        "title": "Camera list path",
        "advanced": true,
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        }
      },
      "streamPath": {
        "type": "string",
        "title": "Stream path template",
        "advanced": true,
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        }
      },
      "preferredId": {
        "type": "string",
        "title": "Preferred camera ID",
        "showWhen": {
          "provider": [
            "camera-service"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "advanced": true,
        "showWhen": {
          "provider": [
            "stream",
            "camera-service"
          ]
        }
      }
    }
  },
  "optionSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title"
      },
      "name": {
        "type": "string",
        "title": "Camera label"
      }
    }
  }
}
