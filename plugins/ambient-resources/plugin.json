{
  "name": "Ambient camera resources",
  "description": "Demo data or a compatible HTTP service for the Ambient display collection.",
  "version": "1.0.0",
  "license": "MIT",
  "category": "Sources",
  "defaultConfig": {
    "provider": "demo"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Data source",
        "enum": [
          "demo",
          "http-json"
        ],
        "enumLabels": {
          "demo": "Sample data",
          "http-json": "Web endpoint (JSON)"
        }
      },
      "baseUrl": {
        "type": "string",
        "title": "Service URL",
        "showWhen": {
          "provider": [
            "http-json"
          ]
        }
      },
      "headers": {
        "type": "object",
        "title": "Request headers",
        "sensitive": true,
        "showWhen": {
          "provider": [
            "http-json"
          ]
        },
        "advanced": true
      },
      "timeoutMs": {
        "type": "integer",
        "title": "Timeout · milliseconds",
        "minimum": 500,
        "maximum": 120000,
        "advanced": true
      }
    }
  }
}
