    },
    "ambient-portfolio": {
      "type": "ambient-portfolio",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "portfolio": "ambient-portfolio-source"
      }
    },
    "ambient-recovery": {
