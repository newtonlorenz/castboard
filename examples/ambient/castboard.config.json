{
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "branding": {
    "name": "Ambient demo",
    "timeZone": "UTC",
    "locationLabel": "Demo location"
  },
  "defaultScreen": "gallery",
  "plugins": {
    "ambient-runtime": {
      "type": "ambient-runtime",
      "enabled": true
    },
    "ambient-theme": {
      "type": "ambient-theme",
      "enabled": true
    },
    "ambient-resources": {
      "provider": "demo",
      "type": "ambient-resources",
      "enabled": true
    },
    "ambient-alerts": {
      "type": "ambient-alerts",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "resources": "ambient-resources",
        "alerts": "ambient-alerts-source"
      }
    },
    "ambient-calendar-source": {
      "provider": "demo",
      "type": "ambient-calendar-source",
      "enabled": true
    },
    "ambient-calendar": {
      "type": "ambient-calendar",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "calendar": "ambient-calendar-source"
      }
    },
    "ambient-camera": {
      "type": "ambient-camera",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "resources": "ambient-resources"
      }
    },
    "ambient-clock": {
      "type": "ambient-clock",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme"
      }
    },
    "ambient-recovery-source": {
      "provider": "demo",
      "type": "ambient-recovery-source",
      "enabled": true
    },
    "ambient-focus": {
      "type": "ambient-focus",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "calendar": "ambient-calendar-source"
      }
    },
    "ambient-media-source": {
      "provider": "demo",
      "type": "ambient-media-source",
      "enabled": true
    },
    "ambient-launch-source": {
      "type": "ambient-launch-source",
      "enabled": true
    },
    "ambient-media": {
      "type": "ambient-media",
      "enabled": true,
      "bindings": {
        "runtime": "ambient-runtime",
        "theme": "ambient-theme",
        "media": "ambient-media-source",
        "launch": "ambient-launch-source"
      }
    },
    "ambient-portfolio-source": {
      "provider": "demo",
      "type": "ambient-portfolio-source",
      "enabled": true
    },
